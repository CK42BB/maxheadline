# Required — Anthropic Claude API for news generation + power rankings
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required — ElevenLabs TTS for character voices
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional — Railway auto-injects this. For local dev, use a local PostgreSQL URL.
# Without it, the server falls back to JSON file caching (no audio persistence).
# DATABASE_URL=postgresql://user:password@localhost:5432/maxheadline

# Optional — Railway auto-injects this. Defaults to 3000.
# PORT=3000
